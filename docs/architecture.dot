// Architecture diagram. Render with:  dot -Tpng docs/architecture.dot -o docs/architecture.png
digraph arch {
  graph [rankdir=LR, fontname="Helvetica", fontsize=11, nodesep=0.45, ranksep=0.7, pad=0.3, newrank=true];
  node  [shape=box, style="rounded,filled", fillcolor="white", fontname="Helvetica", fontsize=10, margin="0.15,0.08"];
  edge  [fontname="Helvetica", fontsize=9, color="#444444"];

  subgraph cluster_internet {
    label="Internet"; style="rounded,dashed"; color="#999999";
    user      [label="Visitor's browser", fillcolor="#eef4ff"];
    registrar [label="Vercel DNS (parent domain gadgetgroveny.com)\nNS records delegate cloud. to Cloud DNS", fillcolor="#f5f5f5"];
    le        [label="Let's Encrypt\n(certificate authority)", fillcolor="#f5f5f5"];
    admin     [label="Admin laptop\n(Terraform, gcloud)", fillcolor="#f5f5f5"];
  }

  subgraph cluster_gcp {
    label="Google Cloud project  (region us-central1)"; style="rounded"; color="#4285F4"; penwidth=1.5;

    dns [label="Cloud DNS zone cloud.gadgetgroveny.com\nA  cloud -> 34.72.141.1\nA  www.cloud -> 34.72.141.1\nCAA  letsencrypt.org only", fillcolor="#e8f0fe"];
    ip  [label="Static external IP\n(Premium Tier)", fillcolor="#e8f0fe"];
    iap [label="Identity-Aware Proxy\n35.235.240.0/20", fillcolor="#e8f0fe"];

    subgraph cluster_vpc {
      label="VPC web-vpc, subnet 10.10.0.0/24 (us-central1)"; style="rounded"; color="#34A853";
      fw [label="Firewall\nallow tcp:80,443 from 0.0.0.0/0\nallow tcp:22 from IAP range only\neverything else denied", fillcolor="#e6f4ea"];
      subgraph cluster_vm {
        label="VM web-1  (e2-micro, Debian 12, Shielded VM, OS Login)"; style="rounded,filled"; fillcolor="#f6fbf7"; color="#34A853";
        caddy [label="Caddy  :80 :443\nTLS termination, HTTP->HTTPS,\nsecurity headers", fillcolor="#ffffff"];
        app   [label="Python web service\n127.0.0.1:8080\n(systemd, user webapp)", fillcolor="#ffffff"];
      }
    }

    sa     [label="Service account web-vm\n(no keys; token from\nmetadata server)", fillcolor="#fef7e0"];
    bucket [label="Cloud Storage bucket (private)\nuniform access, public access\nprevention, versioning\nsite/  public/  release/", fillcolor="#fce8e6"];
  }

  user -> dns      [label="1. DNS lookup"];
  registrar -> dns [label="NS delegation (subdomain only)", style=dashed];
  user -> ip       [label="2. HTTPS :443", color="#1a73e8", penwidth=1.6];
  ip -> fw -> caddy [color="#1a73e8", penwidth=1.6];
  caddy -> app     [label="3. reverse proxy", color="#1a73e8", penwidth=1.6];
  app -> bucket    [label="4. read objects\n(JSON API, HTTPS)", color="#d93025"];
  app -> sa        [label="token", style=dashed];
  sa -> bucket     [label="roles/storage.objectViewer\non this bucket only", style=dashed, color="#e37400", fontcolor="#e37400"];
  le -> caddy      [label="certificate (ACME)", style=dashed];
  admin -> iap     [label="SSH (OS Login)", style=dashed];
  iap -> fw        [style=dashed];
  admin -> bucket  [label="terraform apply\nuploads content", style=dashed];
}
